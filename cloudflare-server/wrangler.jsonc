{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ars-anima-rooms",
  "main": "build/worker.js",
  "no_bundle": true,
  "build": { "command": "node build.mjs" },
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" },
      { "name": "ROOM_DIRECTORY", "class_name": "RoomDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "RoomDirectory"] }
  ],
  "vars": {
    "ALLOW_GUESTS": "1",
    "SUPABASE_URL": "https://bzjxhczkecjmalpfxecp.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0CS-v8yneNR3cTi0McoVzQ_HIrdYZY8"
  }
  // Secreto (no va aquí): npx wrangler secret put MP_SERVER_SECRET
}
